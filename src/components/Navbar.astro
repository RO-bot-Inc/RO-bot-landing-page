---
const currentPath = Astro.url.pathname;
// Free Tools menu: the Story Checker first, then utilities that live inside blog posts.
const tools = [
  { href: '/warranty-story-checker/', name: 'Warranty Story Checker', note: 'Grade a story the way the auditor will' },
  { href: '/blog/warranty-parts-markup-increase/#markup-calculator', name: 'Parts Markup Calculator', note: 'What a warranty markup increase is worth' },
  { href: '/blog/warranty-parts-markup-increase/#ro-sample-worksheet', name: 'Parts Markup Worksheet', note: 'The RO sample, one tab per role' },
  { href: '/blog/multi-point-inspection-checklist/#printable-checklist', name: 'MPI Checklist', note: 'All 38 points on one printable page' },
  { href: '/blog/mpi-video-guide/#shot-list', name: 'MPI Video Shot List', note: 'What to film, taped inside the toolbox lid' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-navy/95 backdrop-blur-sm border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-end gap-2">
        <img src="/badge-white.svg" alt="TenthGear" class="h-6 w-auto mb-0.5">
        <span class="text-white font-bold text-[1.18rem] leading-none">TenthGear</span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-center gap-8">
        <a href="/product/" class="text-sm text-white/70 hover:text-white transition-colors">Product</a>
        <a href="/pricing/" class="text-sm text-white/70 hover:text-white transition-colors">Pricing</a>
        <div class="relative group" id="tools-menu">
          <button type="button" id="tools-btn" aria-expanded="false" aria-controls="tools-panel" class="flex items-center gap-1 text-sm text-white/70 hover:text-white group-hover:text-white transition-colors">
            Free Tools
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <!-- pt-3 bridges the gap so the menu stays open while the pointer moves down -->
          <div id="tools-panel" class="absolute left-1/2 -translate-x-1/2 top-full pt-3 w-80 invisible opacity-0 group-hover:visible group-hover:opacity-100 data-[open]:visible data-[open]:opacity-100 transition-opacity">
            <ul class="rounded-xl bg-white shadow-xl ring-1 ring-black/10 p-2">
              {tools.map((t) => (
                <li>
                  <a href={t.href} class="block rounded-lg px-3 py-2.5 hover:bg-gray-100 focus:bg-gray-100 focus:outline-none">
                    <span class="block text-sm font-semibold text-gray-900">{t.name}</span>
                    <span class="block text-xs text-gray-500 mt-0.5">{t.note}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <a href="/blog/" class="text-sm text-white/70 hover:text-white transition-colors">Blog</a>
        <a href="/about/" class="text-sm text-white/70 hover:text-white transition-colors">About</a>
        <a href="https://app.tenthgear.ai" target="_blank" rel="noopener noreferrer" class="text-sm text-white/70 hover:text-white transition-colors">Log In</a>
        <a href="/book-demo/" class="bg-teal hover:bg-teal-dark text-white text-sm font-semibold px-5 py-2 rounded-lg transition-colors">
          Book Your Demo
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button id="mobile-menu-btn" class="md:hidden text-white" aria-label="Open menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-navy border-t border-white/10">
    <div class="px-4 py-4 space-y-3">
      <a href="/product/" class="block text-white/70 hover:text-white transition-colors">Product</a>
      <a href="/pricing/" class="block text-white/70 hover:text-white transition-colors">Pricing</a>
      <div>
        <p class="text-white/40 text-xs font-semibold uppercase tracking-wider">Free Tools</p>
        <div class="mt-2 pl-3 border-l border-white/15 space-y-2">
          {tools.map((t) => (
            <a href={t.href} class="block text-white/70 hover:text-white transition-colors">{t.name}</a>
          ))}
        </div>
      </div>
      <a href="/blog/" class="block text-white/70 hover:text-white transition-colors">Blog</a>
      <a href="/about/" class="block text-white/70 hover:text-white transition-colors">About</a>
      <a href="https://app.tenthgear.ai" target="_blank" rel="noopener noreferrer" class="block text-white/70 hover:text-white transition-colors">Log In</a>
      <a href="/book-demo/" class="block bg-teal text-white text-center font-semibold px-5 py-2 rounded-lg">
        Book Your Demo
      </a>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  // Free Tools: opens on hover via CSS; click or Enter toggles it (touch, keyboard); Escape or tabbing out closes it.
  const toolsMenu = document.getElementById('tools-menu');
  const toolsBtn = document.getElementById('tools-btn');
  const toolsPanel = document.getElementById('tools-panel');
  const setTools = (open: boolean) => {
    toolsBtn?.setAttribute('aria-expanded', String(open));
    if (open) toolsPanel?.setAttribute('data-open', '');
    else toolsPanel?.removeAttribute('data-open');
  };
  toolsBtn?.addEventListener('click', () => setTools(!toolsPanel?.hasAttribute('data-open')));
  document.addEventListener('click', (e) => { if (toolsMenu && !toolsMenu.contains(e.target as Node)) setTools(false); });
  toolsMenu?.addEventListener('focusout', (e) => { if (!toolsMenu.contains(e.relatedTarget as Node)) setTools(false); });
  toolsMenu?.addEventListener('keydown', (e) => { if (e.key === 'Escape') { setTools(false); toolsBtn?.focus(); } });
</script>
