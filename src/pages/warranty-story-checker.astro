</head>
<body class="sc-body">
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WXBWBW8X"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

  <header class="sc-top">
    <div class="sc-wrap sc-top-in">
      <a href="/" class="sc-brand" aria-label="TenthGear home">
        <img src="/badge-white.svg" alt="" width="21" height="20">
        <span class="sc-brand-name">TenthGear</span>
      </a>
      <span class="sc-slash" aria-hidden="true">/</span>
      <span class="sc-tool-name">Warranty Story Checker</span>
    </div>
  </header>

  <main class="sc-wrap sc-main" id="sc">
    <h1 class="sc-h1">What would a warranty auditor say?</h1>
    <p class="sc-mock" id="sc-mock" hidden>Test mode: no grader key on this deploy, so pasted stories get a rough stand-in grade. Samples show real grades.</p>

    <div class="sc-cols">
      <!-- LEFT: the story -->
      <section class="sc-card sc-left" aria-labelledby="sc-story-h">
        <div class="sc-card-head">
          <h2 id="sc-story-h" class="sc-card-title">Your story</h2>
          <span class="sc-head-right" id="sc-edit-tools">
            <span class="sc-sample-tag" id="sc-sample-tag" hidden></span>
            <button type="button" class="sc-pill sc-roulette" id="sc-sample">Story Roulette</button>
          </span>
          <span class="sc-rv-status" id="sc-rv-status" aria-live="polite" hidden><i aria-hidden="true"></i><span id="sc-rv-status-text"></span></span>
          <span class="sc-sr" id="sc-rv-said" aria-live="polite"></span>
          <button type="button" class="sc-pill" id="sc-reedit" hidden>Edit and regrade</button>
        </div>

        <form class="sc-edit" id="sc-edit" novalidate>
          <div class="sc-field">
            <label for="sc-complaint"><span class="sc-tag">Complaint</span></label>
            <textarea id="sc-complaint" rows="1" maxlength="2000" placeholder="What the customer said."></textarea>
          </div>
          <div class="sc-field">
            <label for="sc-cause"><span class="sc-tag">Cause</span></label>
            <textarea id="sc-cause" rows="3" maxlength="2000" placeholder="What you checked, what you found, what failed."></textarea>
          </div>
          <div class="sc-field">
            <label for="sc-correction"><span class="sc-tag">Correction</span></label>
            <textarea id="sc-correction" rows="2" maxlength="2000" placeholder="What you did and how you confirmed the fix."></textarea>
          </div>
          <div class="sc-hp" aria-hidden="true"><label>Leave blank <input id="sc-website" tabindex="-1" autocomplete="off"></label></div>
          <button type="submit" class="sc-go" id="sc-go">Grade my story</button>
          <p class="sc-err" id="sc-err" role="alert" hidden></p>
          <p class="sc-fine"><span id="sc-left">5 of 5 free checks left today</span> · No customer names, please. We don't keep your story.</p>
        </form>

        <!-- First look: the misfire sample types itself in, then a red pen marks it up and writes in the margins, on a loop until the visitor takes a turn -->
        <div class="sc-live" id="sc-live" hidden>
          <div class="sc-live-story">
            <div class="sc-live-col">
              <div class="sc-live-cw">
                <p class="sc-ml">Complaint</p>
                <p class="sc-mono sc-live-text sc-live-complaint"></p>
              </div>
              <p class="sc-ml">Cause</p>
              <p class="sc-mono sc-live-text sc-live-cause"></p>
              <p class="sc-ml">Correction</p>
              <p class="sc-mono sc-live-text sc-live-corr"></p>
            </div>
            <svg class="sc-live-ink" aria-hidden="true"></svg>
            <div class="sc-live-notes" aria-hidden="true"></div>
            <div class="sc-stamp sc-live-stamp" aria-hidden="true"></div>
            <div class="sc-live-pen" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            <div class="sc-live-stamper" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
          </div>
          <div class="sc-live-foot"><button type="button" class="sc-live-go" id="sc-live-go">Try again</button></div>
        </div>

        <!-- Grading: the same red pen reads the visitor's story while the grader works, then marks it up note by note and stamps the grade -->
        <div class="sc-live sc-review" id="sc-review" hidden>
          <div class="sc-live-story">
            <div class="sc-live-col">
              <div class="sc-live-cw">
                <p class="sc-ml">Complaint</p>
                <p class="sc-mono sc-live-text sc-live-complaint"></p>
              </div>
              <p class="sc-ml">Cause</p>
              <p class="sc-mono sc-live-text sc-live-cause"></p>
              <p class="sc-ml">Correction</p>
              <p class="sc-mono sc-live-text sc-live-corr"></p>
            </div>
            <svg class="sc-live-ink" aria-hidden="true"></svg>
            <div class="sc-live-notes" aria-hidden="true"></div>
            <div class="sc-stamp sc-live-stamp" id="sc-rv-stamp" role="img"></div>
            <button type="button" class="sc-a-toggle" id="sc-a-toggle" hidden>See this story written to an A →</button>
            <div class="sc-live-pen" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            <div class="sc-live-stamper" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
          </div>
        </div>
      </section>

      <!-- RIGHT: what the auditor would say -->
      <div class="sc-right" id="sc-right">
        <div class="sc-results" id="sc-results" hidden>
          <div class="sc-a" id="sc-a" hidden></div>
          <div class="sc-card sc-summary" id="sc-summary"></div>
          <div class="sc-clean" id="sc-clean" hidden><p class="sc-pen sc-pen-teal">Nothing to red-pen. Nice work.</p></div>
          <div class="sc-notes" id="sc-notes"></div>
          <button type="button" class="sc-another" id="sc-another">Check another story</button>
        </div>
      </div>
    </div>
    <div class="sc-cta-row"><a href="/book-demo/" class="sc-cta" id="sc-demo-link">AI story writer and grader: book a demo →</a></div>
  </main>

  <footer class="sc-foot">
    <span>Guidance, not a guarantee. Your automaker's rules come first.</span>
  </footer>

  <!-- Daily limit / demo form. Posts to the site's existing demo-request Netlify form. -->
  <div class="sc-overlay" id="sc-modal" hidden>
    <div class="sc-dialog" role="dialog" aria-modal="true" aria-labelledby="sc-lim-title">
      <form id="sc-demo" novalidate>
        <p id="sc-lim-title" class="sc-lim-title">That's your 5 free checks for today</p>
        <p class="sc-lim-copy">See how TenthGear writes and grades every story before it's submitted. Book a 15-minute demo and keep checking today.</p>
        <input type="hidden" name="form-name" value="demo-request">
        <DemoAttributionFields />
        <div class="sc-hp" aria-hidden="true"><label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off"></label></div>
        <label for="sc-d-name" class="sc-sr">Your name</label>
        <input id="sc-d-name" name="name" type="text" autocomplete="name" placeholder="Your name">
        <label for="sc-d-email" class="sc-sr">Work email</label>
        <input id="sc-d-email" name="email" type="email" autocomplete="email" placeholder="Work email">
        <label for="sc-d-store" class="sc-sr">Dealership</label>
        <input id="sc-d-store" name="dealership" type="text" autocomplete="organization" placeholder="Dealership">
        <button type="submit" class="sc-go" id="sc-d-go">Book my demo</button>
        <p class="sc-err" id="sc-d-err" role="alert" hidden></p>
        <button type="button" class="sc-close" id="sc-close">Not now (checks reset tomorrow)</button>
      </form>
      <div id="sc-thanks" hidden>
        <p class="sc-pen sc-pen-thanks" id="sc-thanks-title">Thanks.</p>
        <p class="sc-lim-copy" id="sc-thanks-copy">We'll be in touch to set up your demo. Keep checking stories as long as you like today.</p>
        <button type="button" class="sc-go" id="sc-keep">Keep checking</button>
      </div>
    </div>
  </div>

  <DemoAttribution />
  <script>
    import '../scripts/story-check/app';
  </script>

  <style is:global>
    .sc-body [hidden] { display: none !important; }
    .sc-body { margin: 0; background: #F4F3F3; color: #000; font-family: 'DM Sans', system-ui, sans-serif; min-height: 100vh; display: flex; flex-direction: column; }
    .sc-wrap { max-width: 76rem; margin: 0 auto; padding-left: 16px; padding-right: 16px; width: 100%; box-sizing: border-box; }
    .sc-top { background: #000; }
    /* Large monitors: scale the whole tool up instead of leaving a small island in an empty screen. */
    @media (min-width: 1680px) { .sc-top-in, .sc-main, .sc-foot, .sc-overlay > * { zoom: 1.15; } }
    @media (min-width: 1920px) { .sc-top-in, .sc-main, .sc-foot, .sc-overlay > * { zoom: 1.3; } }
    @media (min-width: 2400px) { .sc-top-in, .sc-main, .sc-foot, .sc-overlay > * { zoom: 1.5; } }
    .sc-top-in { height: 52px; display: flex; align-items: center; gap: 10px; min-width: 0; }
    .sc-brand { display: flex; align-items: center; gap: 10px; color: #fff; text-decoration: none; flex-shrink: 0; }
    .sc-brand-name { font-weight: 700; font-size: 16px; }
    .sc-slash { color: rgba(255,255,255,0.35); }
    .sc-tool-name { color: #fff; font-weight: 500; font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sc-main { padding-top: 20px; padding-bottom: 40px; flex: 1; }
    .sc-h1 { margin: 0 0 14px; font-size: 22px; font-weight: 800; line-height: 1.25; }
    .sc-mock { margin: 0 0 12px; padding: 8px 12px; border-radius: 8px; background: rgba(255,210,63,0.45); color: #000; font-size: 13px; }
    .sc-cols { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-start; }
    .sc-card { background: #fff; border: 1px solid rgba(0,0,0,0.12); border-radius: 14px; }
    .sc-left { flex: 1 1 440px; min-width: 0; overflow: hidden; }
    .sc-right { flex: 1 1 360px; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
    .sc-card-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 16px; border-bottom: 1px solid rgba(0,0,0,0.08); }
    .sc-card-title { margin: 0; font-size: 16px; font-weight: 700; }
    .sc-head-right { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .sc-sample-tag { font-size: 13px; color: #333132; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sc-pill { flex-shrink: 0; background: #EBEAEA; border: 0; border-radius: 999px; padding: 6px 12px; font: inherit; font-size: 13px; font-weight: 600; color: #000; cursor: pointer; min-height: 32px; }
    .sc-pill:hover { background: #DEDCDD; }
    /* Same column as the graded card (pen.ts fitColumns sets --g and --gap). */
    .sc-edit { padding: 22px 20px; display: grid; grid-template-columns: var(--g, 0px) minmax(0, 1fr) var(--g, 0px); column-gap: var(--gap, 0px); row-gap: 16px; margin: 0; }
    .sc-edit > * { grid-column: 2; }
    .sc-field { display: flex; flex-direction: column; gap: 6px; }
    /* Section labels: small grey capitals over each box, like a printed form. Not tags, not buttons. */
    .sc-field label { display: flex; align-items: center; gap: 8px; }
    .sc-tag, .sc-ml { display: block; align-self: flex-start; padding: 0 0 0 2px; color: #6E6A6C; font-family: 'DM Sans', system-ui, sans-serif; font-size: 12.5px; font-weight: 700; line-height: 1.2; letter-spacing: 0.12em; text-transform: uppercase; }
    .sc-roulette { background: #B9314F; color: #fff; }
    .sc-roulette:hover { background: #8A2239; }
    .sc-edit .sc-go { width: 50%; justify-self: center; }
    /* Same as the home page's Book a Demo button (teal, semibold), with rounder corners. */
    .sc-cta-row { margin-top: 20px; text-align: center; }
    .sc-cta { display: inline-block; padding: 16px 32px; border-radius: 14px; background: #2A9D8F; color: #fff; font-size: 19px; font-weight: 700; /* large text, so white on this teal passes contrast */ line-height: 1.4; text-decoration: none; transition: background 0.15s; }
    .sc-cta:hover { background: #1F7A6F; }
    .sc-field textarea { box-sizing: border-box; display: block; width: 100%; margin: 0; font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 17px; line-height: 2.4; padding: 4px 14px; border: 1px solid rgba(0,0,0,0.18); border-radius: 10px; resize: none; overflow: hidden; color: #000; background: #fff; white-space: pre-wrap; overflow-wrap: anywhere; }
    .sc-edit.is-stacked .sc-field textarea { font-size: 15px; line-height: 2.3; }
    .sc-edit.is-stacked #sc-complaint { padding-right: 76px; }
    .sc-body textarea::placeholder, .sc-body input::placeholder { color: #9B9799; }
    .sc-body textarea:focus, .sc-body input:focus { outline: 2px solid #000; outline-offset: 0; border-color: transparent; }
    .sc-go { font: inherit; font-weight: 700; font-size: 17px; padding: 14px; border-radius: 10px; border: 0; cursor: pointer; min-height: 52px; color: #fff; background: #000; }
    .sc-go:hover { background: #333132; }
    .sc-go.is-empty { background: #9B9799; }
    .sc-go:disabled { opacity: 0.7; cursor: default; }
    .sc-err { margin: 0; font-size: 14px; color: #B9314F; }
    .sc-fine { margin: 0; font-size: 13px; color: #333132; }
    .sc-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
    .sc-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .sc-stamp { position: absolute; top: 12px; right: 14px; width: 80px; height: 80px; border: 4px solid #B9314F; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; transform: rotate(8deg); background: rgba(255,255,255,0.92); font-family: 'Caveat', cursive; font-weight: 700; color: #B9314F; }
    .sc-stamp.is-good { border-color: #78BC61; color: #000; }
    .sc-stamp-l { font-size: 42px; line-height: 0.9; }
    .sc-stamp-g { font-size: 16px; }
    .sc-ml { margin: 0 0 6px; }
    .sc-mono { margin: 0; font-size: 15.5px; line-height: 1.95; font-family: ui-monospace, 'SF Mono', Menlo, monospace; white-space: pre-wrap; overflow-wrap: anywhere; }
    .sc-a-toggle { position: absolute; z-index: 2; white-space: nowrap; background: #fff; border: 1px solid #78BC61; border-radius: 999px; padding: 4px 12px; font: inherit; font-size: 13.5px; font-weight: 700; color: #000; cursor: pointer; }
    .sc-a-toggle:hover { background: rgba(120,188,97,0.2); }
    .sc-a { border: 2px solid #78BC61; border-radius: 10px; background: #fff; padding: 14px 14px 12px; }
    .sc-a-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; font-weight: 700; color: #000; }
    .sc-a-head b { font-size: 24px; font-weight: 800; }
    .sc-a p { margin: 0 0 8px; font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 13.5px; line-height: 1.75; color: #333132; }
    .sc-a p strong { font-family: 'DM Sans', sans-serif; color: #000; }
    .sc-good { background: rgba(120,188,97,0.28); color: #000; border-radius: 3px; padding: 0 2px; }
    .sc-live-story { position: relative; cursor: text; display: grid; grid-template-columns: var(--g, 0px) minmax(0, 1fr) var(--g, 0px); column-gap: var(--gap, 0px); padding: var(--above, 22px) 20px var(--below, 22px); }
    .sc-live-col { grid-column: 2; min-width: 0; }
    /* The story sits in boxes that read as the form fields it was typed into. */
    .sc-live-text { font-size: 17px; line-height: 2.4; margin: 0 0 16px; padding: 4px 14px; background: #fff; border: 1px solid rgba(0,0,0,0.18); border-radius: 10px; min-height: 2.4em; transition: border-color 0.15s, box-shadow 0.15s; }
    .sc-live-text.is-focus { border-color: #000; box-shadow: 0 0 0 1px #000; }
    .sc-live-corr { margin-bottom: 0; }
    .sc-live.is-stacked .sc-live-cw .sc-live-text, .sc-live.is-stacked .sc-live-cw[hidden] ~ .sc-live-cause { padding-right: 76px; }
    .sc-review .sc-live-story { cursor: default; }
    .sc-review [data-mark] { cursor: pointer; border-radius: 3px; transition: background 0.15s; }
    .sc-review [data-mark].is-on { background: rgba(255,210,63,0.55); }
    .sc-rv-status { min-height: 32px; display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: #333132; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sc-rv-status i { flex-shrink: 0; width: 9px; height: 9px; border-radius: 50%; background: #B9314F; animation: sc-blink 1.1s ease-in-out infinite; }
    .sc-cols.is-wide .sc-right { flex-basis: 100%; }
    .sc-cols.is-wide .sc-results { max-width: 52rem; margin: 0 auto; width: 100%; }
    .sc-live.is-stacked .sc-live-text { font-size: 15px; line-height: 2.3; }
    .sc-live-rest { color: transparent; }
    .sc-live-caret { display: inline-block; width: 0; height: 1.15em; vertical-align: -0.22em; box-shadow: 2px 0 0 #000; animation: sc-blink 1s steps(1) infinite; }
    .sc-live-ink { position: absolute; left: 0; top: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
    .sc-live-ink path { fill: none; stroke: #B9314F; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; opacity: 0.9; }
    .sc-live-notes { position: absolute; inset: 0; pointer-events: none; }
    .sc-live-note { position: absolute; font-family: 'Caveat', cursive; font-weight: 700; color: #B9314F; white-space: nowrap; line-height: 1.05; }
    .sc-live-num { position: absolute; font-family: 'Caveat', cursive; font-weight: 700; color: #B9314F; font-size: 19px; line-height: 1; }
    .sc-live-stamp { width: 96px; height: 96px; top: 0; left: 0; right: auto; opacity: 0; transform-origin: 50% 50%; }
    .sc-live-stamp .sc-stamp-l { font-size: 46px; }
    .sc-live-stamp .sc-stamp-g { font-size: 18px; }
    .sc-live.is-stacked .sc-live-stamp { width: 66px; height: 66px; border-width: 3px; }
    .sc-live.is-stacked .sc-live-stamp .sc-stamp-l { font-size: 32px; }
    .sc-live.is-stacked .sc-live-stamp .sc-stamp-g { font-size: 13px; }
    .sc-live-pen { position: absolute; left: 0; top: 0; width: 170px; height: 13px; display: flex; transform-origin: 0 50%; pointer-events: none; opacity: 0; transition: opacity 0.18s, filter 0.18s; filter: drop-shadow(0 5px 5px rgba(0,0,0,0.25)); }
    .sc-live-pen.is-on { opacity: 1; }
    .sc-live-pen.is-up { filter: drop-shadow(0 14px 10px rgba(0,0,0,0.2)); }
    .sc-live-pen i:nth-child(1) { width: 0; height: 0; border-top: 6.5px solid transparent; border-bottom: 6.5px solid transparent; border-right: 18px solid #DEDCDD; }
    .sc-live-pen i:nth-child(2) { width: 12px; background: #9B9799; }
    .sc-live-pen i:nth-child(3) { flex: 1; background: #B9314F; }
    .sc-live-pen i:nth-child(4) { width: 26px; background: #333132; border-radius: 0 6px 6px 0; }
    .sc-live.is-stacked .sc-live-pen { width: 120px; height: 10px; }
    .sc-live-stamper { position: absolute; left: 0; top: 0; width: 110px; height: 130px; pointer-events: none; opacity: 0; transform-origin: 50% 100%; filter: drop-shadow(0 16px 14px rgba(0,0,0,0.28)); }
    .sc-live-stamper i { position: absolute; display: block; }
    .sc-live-stamper i:nth-child(1) { left: 50%; top: 0; width: 46px; height: 46px; margin-left: -23px; border-radius: 50%; background: #000; }
