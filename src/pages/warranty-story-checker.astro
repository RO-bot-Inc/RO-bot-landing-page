</head>
<body class="sc-body">
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WXBWBW8X"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

  <header class="sc-top">
    <div class="sc-wrap sc-top-in">
      <a href="/" class="sc-brand" aria-label="TenthGear home">
        <img src="/badge-white.svg" alt="" width="21" height="20">
        <span class="sc-brand-name">TenthGear</span>
      </a>
      <span class="sc-slash" aria-hidden="true">/</span>
      <span class="sc-tool-name">Warranty Story Checker</span>
    </div>
  </header>

  <main class="sc-wrap sc-main" id="sc">
    <h1 class="sc-h1">Grade a warranty story the way the auditor will</h1>
    <p class="sc-mock" id="sc-mock" hidden>Test mode: no grader key on this deploy, so pasted stories get a rough stand-in grade. Samples show real grades.</p>

    <div class="sc-cols">
      <!-- LEFT: the story -->
      <section class="sc-card sc-left" aria-labelledby="sc-story-h">
        <div class="sc-card-head">
          <h2 id="sc-story-h" class="sc-card-title">Your story</h2>
          <span class="sc-live-tag" id="sc-live-tag" hidden><span class="sc-live-led" aria-hidden="true"></span>Live sample: Misfire</span>
          <span class="sc-head-right" id="sc-edit-tools">
            <span class="sc-sample-tag" id="sc-sample-tag" hidden></span>
            <button type="button" class="sc-pill" id="sc-sample">Paste a sample</button>
          </span>
          <button type="button" class="sc-pill" id="sc-reedit" hidden>Edit and regrade</button>
        </div>

        <form class="sc-edit" id="sc-edit" novalidate>
          <div class="sc-field">
            <label for="sc-cause">Cause</label>
            <textarea id="sc-cause" rows="5" maxlength="2000" placeholder="Paste the cause: what you checked, what you found, what failed."></textarea>
          </div>
          <div class="sc-field">
            <label for="sc-correction">Correction</label>
            <textarea id="sc-correction" rows="3" maxlength="2000" placeholder="Paste the correction: what you did, how you confirmed the fix."></textarea>
          </div>
          <div class="sc-hp" aria-hidden="true"><label>Leave blank <input id="sc-website" tabindex="-1" autocomplete="off"></label></div>
          <button type="submit" class="sc-go" id="sc-go">Grade my story</button>
          <p class="sc-err" id="sc-err" role="alert" hidden></p>
          <p class="sc-fine"><span id="sc-left">5 of 5 free checks left today</span> · No customer names, please. We don't keep your story.</p>
        </form>

        <!-- First look: the misfire sample red-pens itself on a loop until the visitor takes a turn -->
        <div class="sc-live" id="sc-live" hidden>
          <div class="sc-marked sc-live-story">
            <div class="sc-stamp sc-live-stamp" id="sc-live-stamp" aria-hidden="true"></div>
            <p class="sc-ml">Cause</p>
            <p class="sc-mono sc-mono-cause" id="sc-live-cause"></p>
            <p class="sc-ml">Correction</p>
            <p class="sc-mono" id="sc-live-corr"></p>
          </div>
          <div class="sc-live-foot"><button type="button" class="sc-live-go" id="sc-live-go">Your turn: paste your own story</button></div>
        </div>

        <div class="sc-marked" id="sc-marked" hidden>
          <div class="sc-stamp" id="sc-stamp" aria-live="polite"></div>
          <p class="sc-ml">Cause</p>
          <p class="sc-mono sc-mono-cause" id="sc-m-cause"></p>
          <p class="sc-ml">Correction</p>
          <p class="sc-mono" id="sc-m-corr"></p>
          <button type="button" class="sc-a-toggle" id="sc-a-toggle" hidden>See this story written to an A →</button>
          <div class="sc-a" id="sc-a" hidden></div>
        </div>
      </section>

      <!-- RIGHT: what the auditor would say -->
      <div class="sc-right">
        <div class="sc-live-notes" id="sc-live-notes" hidden>
          <p class="sc-live-h">What the auditor writes in the margin</p>
          <ol class="sc-live-list" id="sc-live-list"></ol>
        </div>

        <div class="sc-card sc-grading" id="sc-grading" hidden>
          <div class="sc-grading-head"><span class="sc-spin" aria-hidden="true"></span><span class="sc-pen sc-pen-big">Red pen out...</span></div>
          <p class="sc-step" data-step="0">Reading the cause and correction</p>
          <p class="sc-step" data-step="1">Grading the 6 criteria</p>
          <p class="sc-step" data-step="2">Looking for what an auditor would flag</p>
        </div>

        <div class="sc-results" id="sc-results" hidden>
          <div class="sc-card sc-summary" id="sc-summary"></div>
          <div class="sc-clean" id="sc-clean" hidden><p class="sc-pen sc-pen-teal">Nothing to red-pen. Nice work.</p></div>
          <div class="sc-notes" id="sc-notes"></div>
          <form class="sc-gate" id="sc-gate" novalidate hidden>
            <label for="sc-email" class="sc-gate-title">Email me every fix, to forward to the tech</label>
            <div class="sc-gate-row">
              <input id="sc-email" type="email" autocomplete="email" placeholder="Work email" required>
              <button type="submit" id="sc-send">Send</button>
            </div>
            <p class="sc-gate-err" id="sc-gate-err" hidden></p>
          </form>
          <div class="sc-sent" id="sc-sent" hidden></div>
          <button type="button" class="sc-another" id="sc-another">Check another story</button>
        </div>
      </div>
    </div>
  </main>

  <footer class="sc-foot">
    <span>Guidance, not a guarantee. Your automaker's rules come first.</span>
    <a href="/book-demo/" id="sc-demo-link">Grade every story before it's submitted: book a demo →</a>
  </footer>

  <!-- Daily limit / demo form. Posts to the site's existing demo-request Netlify form. -->
  <div class="sc-overlay" id="sc-modal" hidden>
    <div class="sc-dialog" role="dialog" aria-modal="true" aria-labelledby="sc-lim-title">
      <form id="sc-demo" novalidate>
        <p id="sc-lim-title" class="sc-lim-title">That's your 5 free checks for today</p>
        <p class="sc-lim-copy">See how TenthGear writes and grades every story before it's submitted. Book a 15-minute demo and keep checking today.</p>
        <input type="hidden" name="form-name" value="demo-request">
        <DemoAttributionFields />
        <div class="sc-hp" aria-hidden="true"><label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off"></label></div>
        <label for="sc-d-name" class="sc-sr">Your name</label>
        <input id="sc-d-name" name="name" type="text" autocomplete="name" placeholder="Your name">
        <label for="sc-d-email" class="sc-sr">Work email</label>
        <input id="sc-d-email" name="email" type="email" autocomplete="email" placeholder="Work email">
        <label for="sc-d-store" class="sc-sr">Dealership</label>
        <input id="sc-d-store" name="dealership" type="text" autocomplete="organization" placeholder="Dealership">
        <button type="submit" class="sc-go" id="sc-d-go">Book my demo</button>
        <p class="sc-err" id="sc-d-err" role="alert" hidden></p>
        <button type="button" class="sc-close" id="sc-close">Not now (checks reset tomorrow)</button>
      </form>
      <div id="sc-thanks" hidden>
        <p class="sc-pen sc-pen-thanks" id="sc-thanks-title">Thanks.</p>
        <p class="sc-lim-copy" id="sc-thanks-copy">We'll be in touch to set up your demo. Keep checking stories as long as you like today.</p>
        <button type="button" class="sc-go" id="sc-keep">Keep checking</button>
      </div>
    </div>
  </div>

  <DemoAttribution />
  <script>
    import '../scripts/story-check/app';
  </script>

  <style is:global>
    .sc-body [hidden] { display: none !important; }
    .sc-body { margin: 0; background: #F4F3F3; color: #000; font-family: 'DM Sans', system-ui, sans-serif; min-height: 100vh; display: flex; flex-direction: column; }
    .sc-wrap { max-width: 76rem; margin: 0 auto; padding-left: 16px; padding-right: 16px; width: 100%; box-sizing: border-box; }
    .sc-top { background: #000; }
    /* Large monitors: scale the whole tool up instead of leaving a small island in an empty screen. */
    @media (min-width: 1680px) { .sc-top-in, .sc-main, .sc-foot, .sc-overlay > * { zoom: 1.15; } }
    @media (min-width: 1920px) { .sc-top-in, .sc-main, .sc-foot, .sc-overlay > * { zoom: 1.3; } }
    @media (min-width: 2400px) { .sc-top-in, .sc-main, .sc-foot, .sc-overlay > * { zoom: 1.5; } }
    .sc-top-in { height: 52px; display: flex; align-items: center; gap: 10px; min-width: 0; }
    .sc-brand { display: flex; align-items: center; gap: 10px; color: #fff; text-decoration: none; flex-shrink: 0; }
    .sc-brand-name { font-weight: 700; font-size: 16px; }
    .sc-slash { color: rgba(255,255,255,0.35); }
    .sc-tool-name { color: #fff; font-weight: 500; font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sc-main { padding-top: 20px; padding-bottom: 40px; flex: 1; }
    .sc-h1 { margin: 0 0 14px; font-size: 22px; font-weight: 800; line-height: 1.25; }
    .sc-mock { margin: 0 0 12px; padding: 8px 12px; border-radius: 8px; background: rgba(255,210,63,0.45); color: #000; font-size: 13px; }
    .sc-cols { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-start; }
    .sc-card { background: #fff; border: 1px solid rgba(0,0,0,0.12); border-radius: 14px; }
    .sc-left { flex: 1 1 440px; min-width: 0; overflow: hidden; }
    .sc-right { flex: 1 1 360px; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
    .sc-card-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 16px; border-bottom: 1px solid rgba(0,0,0,0.08); }
    .sc-card-title { margin: 0; font-size: 16px; font-weight: 700; }
    .sc-head-right { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .sc-sample-tag { font-size: 13px; color: #333132; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sc-pill { flex-shrink: 0; background: #EBEAEA; border: 0; border-radius: 999px; padding: 6px 12px; font: inherit; font-size: 13px; font-weight: 600; color: #000; cursor: pointer; min-height: 32px; }
    .sc-pill:hover { background: #DEDCDD; }
    .sc-edit { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 12px; margin: 0; }
    .sc-field { display: flex; flex-direction: column; gap: 6px; }
    .sc-field label { font-size: 13px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: #333132; }
    .sc-field textarea { font: inherit; font-size: 16px; line-height: 1.55; padding: 12px; border: 1px solid rgba(0,0,0,0.18); border-radius: 10px; resize: vertical; color: #000; }
    .sc-body textarea::placeholder, .sc-body input::placeholder { color: #9B9799; }
    .sc-body textarea:focus, .sc-body input:focus { outline: 2px solid #000; outline-offset: 0; border-color: transparent; }
    .sc-go { font: inherit; font-weight: 700; font-size: 17px; padding: 14px; border-radius: 10px; border: 0; cursor: pointer; min-height: 52px; color: #fff; background: #000; }
    .sc-go:hover { background: #333132; }
    .sc-go.is-empty { background: #9B9799; }
    .sc-go:disabled { opacity: 0.7; cursor: default; }
    .sc-err { margin: 0; font-size: 14px; color: #B9314F; }
    .sc-fine { margin: 0; font-size: 13px; color: #333132; }
    .sc-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
    .sc-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .sc-marked { padding: 18px 18px 20px; background: #fff; position: relative; }
    .sc-stamp { position: absolute; top: 12px; right: 14px; width: 80px; height: 80px; border: 4px solid #B9314F; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; transform: rotate(8deg); background: rgba(255,255,255,0.92); font-family: 'Caveat', cursive; font-weight: 700; color: #B9314F; }
    .sc-stamp.is-good { border-color: #78BC61; color: #000; }
    .sc-stamp.is-pop { animation: sc-pop 0.45s ease-out; }
    .sc-stamp-l { font-size: 42px; line-height: 0.9; }
    .sc-stamp-g { font-size: 16px; }
    .sc-ml { margin: 0 0 4px; font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #9B9799; }
    .sc-mono { margin: 0; font-size: 15.5px; line-height: 1.95; font-family: ui-monospace, 'SF Mono', Menlo, monospace; white-space: pre-wrap; overflow-wrap: anywhere; }
    .sc-mono-cause { margin-bottom: 14px; padding-right: 84px; }
    .sc-red { text-decoration: underline wavy #B9314F; text-decoration-thickness: 1.5px; text-underline-offset: 5px; }
    .sc-red.is-on { background: rgba(255,210,63,0.55); border-radius: 3px; }
    .sc-dot { display: inline-flex; width: 22px; height: 22px; border-radius: 50%; border: 0; padding: 0; cursor: pointer; background: #B9314F; color: #fff; font-family: 'DM Sans', sans-serif; font-size: 12px; font-weight: 700; align-items: center; justify-content: center; vertical-align: super; margin-left: 2px; line-height: 1; }
    .sc-dot.is-on { background: #8A2239; }
    .sc-dot-static { width: 18px; height: 18px; font-size: 11px; cursor: default; }
    .sc-a-toggle { margin-top: 16px; background: none; border: 0; padding: 6px 0; font: inherit; font-size: 14px; font-weight: 700; color: #000; cursor: pointer; }
    .sc-a { margin-top: 8px; border: 2px solid #78BC61; border-radius: 10px; background: #fff; padding: 14px 14px 12px; }
    .sc-a-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; font-weight: 700; color: #000; }
    .sc-a-head b { font-size: 24px; font-weight: 800; }
    .sc-a p { margin: 0 0 8px; font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 13.5px; line-height: 1.75; color: #333132; }
    .sc-a p strong { font-family: 'DM Sans', sans-serif; color: #000; }
    .sc-good { background: rgba(120,188,97,0.28); color: #000; border-radius: 3px; padding: 0 2px; }
    .sc-live-tag { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: #333132; }
    .sc-live-led { width: 8px; height: 8px; border-radius: 50%; background: #B9314F; animation: sc-led 1.6s ease-in-out infinite; }
    @keyframes sc-led { 50% { opacity: 0.25; } }
    .sc-live-story { cursor: text; }
    .sc-live-seg { transition: opacity 0.25s; }
    .sc-live-seg.is-off { opacity: 0; }
    .sc-live .sc-red { text-decoration-color: transparent; transition: text-decoration-color 0.3s; }
    .sc-live .sc-red.is-marked { text-decoration-color: #B9314F; }
    .sc-live .sc-dot { cursor: default; width: 0; margin-left: 0; overflow: hidden; transform: scale(0); transition: transform 0.25s cubic-bezier(.3,1.6,.5,1); }
    .sc-live .sc-dot.is-marked { width: 18px; margin-left: 2px; transform: scale(1); }
    .sc-live-stamp { opacity: 0; transform: rotate(8deg) scale(1.7); transition: opacity 0.2s, transform 0.3s cubic-bezier(.3,1.6,.5,1); }
    .sc-live-stamp.is-in { opacity: 1; transform: rotate(8deg) scale(1); }
    .sc-live-foot { padding: 0 18px 18px; }
    .sc-live-go { width: 100%; min-height: 56px; border: 2px dashed #9B9799; background: #FAFAFA; border-radius: 12px; font: inherit; font-size: 16px; font-weight: 700; color: #000; cursor: pointer; }
    .sc-live-go:hover { border-color: #000; background: #fff; }
    .sc-live-notes { display: flex; flex-direction: column; gap: 10px; }
    .sc-live-h { margin: 0; font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #6E6A6C; }
    .sc-live-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
    .sc-live-list li { display: flex; align-items: center; gap: 12px; background: #fff; border: 1px solid rgba(0,0,0,0.12); border-radius: 12px; padding: 8px 14px; opacity: 0.3; transform: translateX(8px); transition: opacity 0.25s, transform 0.25s; }
    .sc-live-list li.is-in { opacity: 1; transform: none; }
    .sc-live-list .sc-dot { cursor: default; flex: none; width: 26px; height: 26px; font-size: 13px; vertical-align: baseline; margin: 0; }
    .sc-live-list .sc-pen { font-size: 26px; }
    @media (prefers-reduced-motion: reduce) { .sc-live-led { animation: none; } .sc-live *, .sc-live-list li { transition: none !important; } }
    .sc-pen { font-family: 'Caveat', cursive; font-weight: 700; color: #B9314F; line-height: 1.1; }
    .sc-pen-big { font-size: 30px; }
    .sc-pen-teal { margin: 0; font-size: 28px; color: #000; }
    .sc-pen-thanks { margin: 0 0 6px; font-size: 34px; color: #000; }
    .sc-grading { padding: 22px; }
    .sc-grading-head { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
    .sc-spin { width: 28px; height: 28px; border: 4px solid rgba(185,49,79,0.2); border-top-color: #B9314F; border-radius: 50%; animation: sc-spin 0.8s linear infinite; box-sizing: border-box; }
    .sc-step { margin: 6px 0; font-size: 15px; color: #9B9799; font-weight: 500; }
    .sc-step.is-now { color: #000; font-weight: 700; }
    .sc-step.is-done { color: #333132; }
    .sc-step.is-done::before { content: '✓ '; }
    .sc-results { display: flex; flex-direction: column; gap: 12px; }
    .sc-summary { padding: 16px 18px; }
    .sc-headline { margin: 0 0 10px; font-size: 18px; font-weight: 800; line-height: 1.3; }
    .sc-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    .sc-el { display: flex; align-items: center; gap: 8px; min-width: 0; }
    .sc-el-label { font-size: 12.5px; font-weight: 600; line-height: 1.25; color: #333132; }
    .sc-chip { flex-shrink: 0; width: 28px; height: 28px; border-radius: 7px; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 800; }
    .sc-chip-A { background: #78BC61; color: #000; }
    .sc-chip-B { background: rgba(120,188,97,0.28); color: #000; }
    .sc-chip-C { background: rgba(255,210,63,0.45); color: #000; }
    .sc-chip-D { background: rgba(185,49,79,0.14); color: #8A2239; }
    .sc-chip-F, .sc-chip-missing { background: #B9314F; color: #fff; }
    .sc-chip-not_applicable { background: #EBEAEA; color: #333132; font-size: 11px; }
    .sc-clean { background: rgba(120,188,97,0.2); border-radius: 14px; padding: 16px 18px; }
    .sc-notes { display: flex; flex-direction: column; gap: 12px; }
    .sc-note { text-align: left; font: inherit; color: inherit; cursor: pointer; width: 100%; background: #fff; border: 1px solid rgba(0,0,0,0.12); border-radius: 12px; padding: 12px 14px; display: flex; gap: 12px; align-items: flex-start; }
    .sc-note.is-on { background: rgba(255,210,63,0.16); border: 2px solid #B9314F; padding: 11px 13px; }
    .sc-note-n { flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%; background: #B9314F; color: #fff; font-size: 13px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
    .sc-note-body { flex: 1; min-width: 0; display: block; }
    .sc-note-top { display: flex; flex-wrap: wrap; gap: 2px 12px; align-items: baseline; margin-bottom: 4px; }
    .sc-note-pen { font-size: 25px; line-height: 1; }
    .sc-note-crit { font-size: 12.5px; font-weight: 600; color: #333132; }
    .sc-note-fix { display: block; font-size: 14.5px; line-height: 1.55; color: #333132; }
