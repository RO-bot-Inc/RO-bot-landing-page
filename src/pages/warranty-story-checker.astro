---
// Free Warranty Story Checker. Grading happens in netlify/functions/story-check.mts;
// the rubric never reaches this page (Dave, 2026-11-11: it stays our secret sauce).
// Prototype and every UX ruling: gtm/docs/story-checker/README.md.
import DemoAttribution from '../components/DemoAttribution.astro';
import DemoAttributionFields from '../components/DemoAttributionFields.astro';
import '../styles/global.css';

const title = 'Free Warranty Story Checker | TenthGear';
const description =
  'Paste a warranty repair story. Get it back red-penned the way a warranty auditor reads it: graded on 6 criteria, with the fix for every note.';
const canonical = 'https://tenthgear.ai/warranty-story-checker/';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google Tag Manager -->
