---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import Solution from '../components/Solution.astro';
import HowItWorks from '../components/HowItWorks.astro';
import DmsIntegrations from '../components/DmsIntegrations.astro';
import Testimonial from '../components/Testimonial.astro';
import CTA from '../components/CTA.astro';
import BrandLogos from '../components/BrandLogos.astro';
import FAQ from '../components/FAQ.astro';
import NewsletterCTA from '../components/NewsletterCTA.astro';

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "TenthGear",
  "url": "https://tenthgear.ai",
  "logo": "https://tenthgear.ai/browser.png",
  "description": "Voice-first AI platform that helps automotive service departments find more work, sell more work, and get paid for more work.",
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "Sales",
    "email": "hello@tenthgear.ai",
    "url": "https://tenthgear.ai/book-demo"
  },
  "sameAs": [
    "https://www.linkedin.com/company/ro-bot"
  ]
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "TenthGear",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "iOS, Android",
  "description": "Voice-first AI platform for automotive service departments. Helps technicians document repairs, conduct inspections, and create video walkthroughs using voice instead of typing.",
  "offers": {
    "@type": "Offer",
    "category": "Subscription"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5",
    "ratingCount": "1"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is TenthGear integrated into our DMS?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "TenthGear currently integrates with ten DMS platforms: Auto/Mate, Tekion, CDK, Reynolds, Dealertrack, PBS, Quorum, Autosoft, DealerBuilt, and Dominion. DMS integration isn't required for all implementations. Give us a call and we'll talk through what makes sense at your shop."
      }
    },
    {
      "@type": "Question",
      "name": "How does TenthGear help technicians work faster?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "TenthGear uses voice-first AI so technicians can document repairs, complete multi-point inspections, and create video walkthroughs by speaking instead of typing. This saves 30+ minutes per day on documentation and keeps techs focused on wrench time."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to set up TenthGear?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "TenthGear can be up and running in about 10 minutes. Technicians download the app on their phone, and they can start recording voice notes right away. No DMS integration is required to get started."
      }
    },
    {
      "@type": "Question",
      "name": "How does TenthGear reduce warranty claim denials?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "TenthGear generates complete 3Cs documentation (Complaint, Cause, Correction) from technician voice notes and grades each story against OEM standards. This ensures every claim has thorough, properly structured documentation before submission, reducing denials caused by incomplete or vague write-ups."
      }
    },
    {
      "@type": "Question",
      "name": "What makes TenthGear different from other service department tools?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "TenthGear is voice-first, meaning technicians never have to stop working to type. It covers the full service workflow: multi-point inspections, AI-guided video inspections, and 3Cs documentation. Most tools require screen time. TenthGear replaces it with voice."
      }
    },
    {
      "@type": "Question",
      "name": "How does the AI-guided video inspection work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "TenthGear provides an on-screen teleprompter that guides technicians through recording vehicle inspection videos. It tells them what to show and what to say, so every video is clear, professional, and more likely to result in customer approval of recommended work."
      }
    }
  ]
};
---

<BaseLayout
  title="TenthGear | Voice-First AI for Automotive Service Departments"
  canonicalPath="/"
  schemaJson={[organizationSchema, softwareSchema, faqSchema]}
  preloadImage="/product3d/left-phone-only.webp"
>
  <Hero />
  <Problem />
  <Solution />
  <HowItWorks />
  <DmsIntegrations />
  <Testimonial />
  <CTA />
  <FAQ />
  <BrandLogos />
  <NewsletterCTA />
</BaseLayout>
