---
// The private workspace: storyboard frames 7 to 16. The token arrives in the
// URL fragment and is moved out of the address bar before any tag loads (see
// the first script). Every word is approved copy from the storyboard.
import { ROUTES } from '../../../scripts/leak-test/presets';

const title = 'Your RO Leak Test | TenthGear';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <script is:inline>
    // Keep the private token out of analytics and referrers: stash it, then
    // strip the fragment before GTM loads.
    (function () {
      try {
        var h = location.hash.slice(1);
        if (h) {
          sessionStorage.setItem('lt_rt', h);
          history.replaceState(null, '', location.pathname + location.search);
        }
      } catch (e) {}
    })();
  </script>
  <!-- Google Tag Manager -->
  <script is:inline>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WXBWBW8X');
  </script>
  <!-- End Google Tag Manager -->

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="referrer" content="no-referrer">
  <meta name="robots" content="noindex, nofollow">
  <title>{title}</title>
  <meta name="theme-color" content="#f4f1ea">
  <link rel="shortcut icon" href="/favicon.ico?v=2">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">
  <link rel="preload" href="/fonts/future-headline/anton-400.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body>
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WXBWBW8X"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

  <main id="rs" data-screen="loading">
    <header class="top">
      <img src="/ai-summit/tg-horizontal-black.svg" alt="TenthGear" width="127" height="22">
      <span class="eyebrow" id="rs-eyebrow">RO Leak Test</span>
    </header>

    <section class="screen" data-name="loading" aria-live="polite">
      <div class="ts"><span class="sp" aria-hidden="true"></span><span>Opening your private page.</span></div>
    </section>

    <!-- Frames 7, 13, 14, 15: overview -->
    <section class="screen" data-name="home" hidden>
      <div class="banner" id="rs-banner" hidden></div>
      <p class="errmsg" id="rs-home-note" hidden role="alert">Calendly has your time. We couldn&rsquo;t record it here yet; it will catch up on your next visit.</p>
      <h1 id="rs-welcome">Welcome back, <span id="rs-first"></span>.</h1>
      <p class="p" id="rs-lede">Let&rsquo;s get this revenue leak test rolling...</p>
      <div class="cards">
        <div class="card" id="rs-card-materials">
          <h2><span id="rs-materials-title">Upload service materials</span> <span class="pill go" id="rs-materials-pill">Not started</span></h2>
          <div id="rs-materials-intro">
            <p>This revenue leak test is only as good as the data you share.</p>
            <ul class="cl"><li>ROs</li><li>MPI reports</li><li>Inspection videos</li><li>Customer-facing materials (quotes, reports, invoices)</li></ul>
          </div>
          <button type="button" class="btn sm" data-go="materials" id="rs-materials-btn">Add materials</button>
        </div>
        <div class="card" id="rs-card-booking">
          <h2><span id="rs-booking-title">Book your review session</span> <span class="pill go" id="rs-booking-pill">Not booked</span></h2>
          <p id="rs-booking-intro">Book a time to walk through the findings and discuss opportunities to get more revenue out of your existing process.</p>
          <button type="button" class="btn sm dark" data-go="book" id="rs-booking-btn">Pick a time</button>
        </div>
      </div>
      <p class="fine">Private to <b id="rs-who"></b>. <button type="button" class="linklike" id="rs-notyou">Not you?</button></p>
    </section>

    <!-- Frames 8, 9, 10, 11: materials workspace -->
    <section class="screen" data-name="materials" hidden>
      <p class="crumb"><button type="button" class="linklike" data-go="home">Back to overview</button></p>
      <h1>Upload service materials</h1>
      <p class="p">This revenue leak test is only as good as the data you share. The more you share, the more detailed we can get with the analysis. Need help gathering these? Just ask. <a href="mailto:dave@tenthgear.ai">dave@tenthgear.ai</a></p>
      <div class="cols">
        <div><b class="lbl">Must haves:</b><ul class="cl"><li>20 recent ROs (more is better)</li></ul></div>
        <div><b class="lbl">Also helpful:</b><ul class="cl"><li>MPI reports</li><li>Inspection videos</li><li>Customer-facing materials (quotes, reports, invoices)</li></ul></div>
      </div>

      <div class="drop" id="rs-drop" tabindex="0" role="button" aria-label="Add files">
        <b>Drop files here</b>
        <span class="linklike">Or choose files</span>
        <span class="fine">(no ZIP files, please)</span>
      </div>
      <div class="box" id="rs-uploads-off" hidden>
        <b class="t">File upload isn&rsquo;t open yet</b>
        Secure upload opens here shortly. Add customer-facing links and a note below now, or reply to your enrollment email and we&rsquo;ll take your files another way.
      </div>
      <p class="fine" id="rs-uploads-mock" hidden>Uploads are simulated on this preview: rows are recorded, no bytes are stored.</p>
      <input type="file" id="rs-file" multiple hidden>
      <ul class="files" id="rs-files" aria-live="polite"></ul>
      <p class="fine" id="rs-usage"></p>

      <div class="cols">
        <div>
          <label>Customer-facing links <i>(optional)</i></label>
          <div id="rs-links"></div>
          <button type="button" class="more" id="rs-add-link">+ Add another link</button>
        </div>
        <div>
          <label for="rs-notes">Anything we should know about these ROs, files, or links? <i>(optional)</i></label>
          <textarea id="rs-notes" rows="4" maxlength="2000"></textarea>
        </div>
      </div>

      <div class="box">
        <b class="t">Before you upload</b>
        We don&rsquo;t need customer names, contact info, or payment info. Please don&rsquo;t share staff logins, passwords, or one-time codes.<br><br>
        These files will be kept strictly confidential. All files will be deleted 60 days after your review.
      </div>

      <div class="row-actions">
        <button type="button" class="btn sm" id="rs-done">Done sharing</button>
        <span class="fine" id="rs-saved">Everything saves as you go. You can leave and come back.</span>
      </div>
    </section>

    <!-- Frame 11: confirm -->
    <div class="scrim" id="rs-confirm" hidden role="dialog" aria-modal="true" aria-labelledby="rs-confirm-h">
      <div class="modal">
        <h2 id="rs-confirm-h">Ready to send?</h2>
        <p id="rs-confirm-text"></p>
        <p class="p">You can still add more later with your private link.</p>
        <div class="row-actions">
          <button type="button" class="btn sm" id="rs-confirm-yes">Yes, send it</button>
          <button type="button" class="btn sm ghost" id="rs-confirm-no">Go back</button>
        </div>
      </div>
    </div>

    <!-- Frame 12: booking -->
    <section class="screen" data-name="book" hidden>
      <p class="crumb"><button type="button" class="linklike" data-go="home">Back to overview</button></p>
      <h1>Book your review session</h1>
      <p class="p">30 minute video call with the TenthGear team.</p>
      <div class="cal" id="rs-cal"></div>
      <p class="fine" id="rs-cal-fallback" hidden>Calendar not loading? <a id="rs-cal-link" href="#" target="_blank" rel="noopener">Open the booking page in a new tab</a>, then come back here.</p>
      <p class="errmsg" id="rs-book-err" hidden role="alert">Calendly has your time. We couldn&rsquo;t record it here yet; reload this page in a minute and it will catch up.</p>
    </section>

    <!-- Frame 16: invalid or expired link -->
    <section class="screen" data-name="invalid" hidden>
      <h1 class="sm">That link didn&rsquo;t open anything.</h1>
      <p class="p">It may be mistyped or cut off, or it has expired. Links last 60 days. Your files and details are safe either way.</p>
      <form id="rs-fresh" novalidate>
        <label for="rs-email">Email you enrolled with</label>
        <input id="rs-email" name="email" type="email" autocomplete="email" inputmode="email" autocapitalize="off" placeholder="you@yourdealership.com" maxlength="120" required>
        <p class="hp" aria-hidden="true"><label>Leave this empty <input name="website" tabindex="-1" autocomplete="off"></label></p>
        <button type="submit" class="btn dark" id="rs-send">Email me a fresh link</button>
        <p class="errmsg" id="rs-fresh-err" hidden role="alert">That didn&rsquo;t go through. Check your connection and try again.</p>
      </form>
      <p class="fine">If that address is enrolled, a new private link arrives in a minute. Not enrolled yet? <a href={ROUTES.landing}>Start here</a>. Stuck? <a href="mailto:support@tenthgear.ai">support@tenthgear.ai</a></p>
    </section>

    <section class="screen" data-name="sent" hidden aria-live="polite">
      <div class="ok" aria-hidden="true">&#10003;</div>
      <h1 class="sm">Check your inbox.</h1>
      <p class="p">If that address is enrolled, a new private link arrives in a minute. The old link no longer works.</p>
    </section>
  </main>

  <script>
    import '../../../scripts/leak-test/resume';
  </script>

  <style is:global>
    @font-face {
      font-family: 'LT Anton';
      src: url('/fonts/future-headline/anton-400.woff2') format('woff2');
      font-weight: 400;
      font-display: swap;
    }
    :root {
      --ink: #000; --char: #333132; --grey: #9b9799; --light: #dedcdd; --paper: #f4f1ea;
      --red: #c8141e; --yellow: #ffd23f; --green: #78bc61;
      --head: 'LT Anton', Impact, 'Arial Narrow Bold', sans-serif;
      --body: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      --mono: ui-monospace, 'SF Mono', Menlo, 'Courier New', monospace;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--body); line-height: 1.45; -webkit-font-smoothing: antialiased; }
    [hidden] { display: none !important; }
    #rs { max-width: 51.25rem; margin: 0 auto; padding: 0 1.25rem calc(2.5rem + env(safe-area-inset-bottom)); }
    .top { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: calc(0.75rem + env(safe-area-inset-top)) 0 0.625rem; border-bottom: 0.125rem solid var(--ink); margin-bottom: 1rem; }
    .top img { height: 1.375rem; width: auto; }
    .eyebrow { font: 700 0.6875rem var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--char); }
    h1 { font-family: var(--head); font-weight: 400; font-size: 2.125rem; line-height: 1.05; text-transform: uppercase; margin: 0.375rem 0 0.25rem; }
    h1.sm { font-size: 1.875rem; }
    h2 { font-family: var(--head); font-weight: 400; font-size: 1.25rem; text-transform: uppercase; margin: 0 0 0.375rem; }
    .p { font-size: 1rem; color: var(--char); margin: 0 0 0.875rem; }
    .p a, .fine a, .linklike { color: var(--ink); }
    .fine { font-size: 0.7813rem; color: var(--char); margin: 0.625rem 0 0; line-height: 1.4; }
    .crumb { margin: 0 0 0.375rem; font-size: 0.875rem; }
    .lbl { font: 700 0.75rem var(--mono); text-transform: uppercase; letter-spacing: 0.05em; }
    .banner { background: var(--ink); color: #fff; padding: 0.75rem 0.875rem; font-size: 0.9375rem; margin: 0 0 0.875rem; }
    .banner.y { background: var(--yellow); color: var(--ink); border: 0.125rem solid var(--ink); }
    .cards { display: grid; gap: 0.875rem; margin-top: 0.625rem; }
    .card { background: #fff; border: 0.125rem solid var(--ink); padding: 0.875rem 1rem; font-size: 0.875rem; }
    .card h2 { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
    .card p { margin: 0 0 0.5rem; }
    .pill { font: 700 0.6563rem var(--mono); text-transform: uppercase; padding: 0.1875rem 0.5rem; border-radius: 1.25rem; border: 0.0938rem solid var(--ink); background: #fff; white-space: nowrap; }
    .pill.go { background: var(--yellow); }
    .pill.done { background: var(--ink); color: #fff; }
    .pill.done::before { content: '\2713 '; }
    ul.cl { margin: 0 0 0.75rem; padding-left: 1.125rem; color: var(--char); }
    .cols { display: grid; gap: 0.875rem; margin: 0.5rem 0 0.75rem; }
    .btn { display: inline-flex; align-items: center; justify-content: center; width: 100%; min-height: 3.25rem; padding: 0.5rem 1rem; border: 0; border-radius: 0.25rem; background: var(--red); color: #fff; font-family: var(--head); font-size: 1.25rem; letter-spacing: 0.02em; text-transform: uppercase; text-decoration: none; cursor: pointer; }
    .btn.sm { width: auto; min-height: 2.625rem; font-size: 1rem; }
    .btn.dark { background: var(--ink); }
    .btn.ghost { background: #fff; color: var(--ink); border: 0.125rem solid var(--ink); }
    .btn[disabled] { background: var(--light); color: var(--grey); cursor: not-allowed; }
    .btn:focus-visible, input:focus-visible, textarea:focus-visible, .linklike:focus-visible, .drop:focus-visible { outline: 0.1875rem solid var(--ink); outline-offset: 0.125rem; }
    .linklike { background: none; border: 0; padding: 0; font: inherit; text-decoration: underline; cursor: pointer; }
    .more { display: block; background: none; border: 0; padding: 0; margin: 0.5rem 0 0; font: 600 0.8125rem var(--body); text-decoration: underline; color: var(--ink); cursor: pointer; }
    label { display: block; font: 600 0.8125rem var(--body); margin: 0.75rem 0 0.25rem; }
    label i { font-style: normal; font-weight: 400; color: var(--char); }
    /* 1rem keeps iOS Safari from zooming the page on focus. */
    input, textarea { width: 100%; min-height: 2.75rem; border: 0.0938rem solid var(--ink); border-radius: 0.25rem; background: #fff; padding: 0.625rem 0.75rem; font: 1rem var(--body); color: var(--ink); }
    textarea { resize: vertical; }
    .link-row { display: flex; gap: 0.375rem; margin-bottom: 0.375rem; }
    .link-row input { min-height: 2.5rem; }
    .link-row button { flex: none; }
    .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
    .errmsg { color: var(--red); font: 600 0.7813rem var(--body); margin: 0.625rem 0 0; }
    .errmsg::before { content: '! '; font-weight: 800; }
    .drop { border: 0.125rem dashed var(--ink); background: #fffdf5; text-align: center; padding: 1.375rem 0.75rem; margin: 0.75rem 0 0.375rem; font-size: 0.875rem; cursor: pointer; display: flex; flex-direction: column; gap: 0.25rem; align-items: center; }
    .drop b { font-family: var(--head); font-weight: 400; font-size: 1.25rem; text-transform: uppercase; }
    .drop.over { background: var(--yellow); }
    .drop .fine { margin: 0; }
    .files { list-style: none; margin: 0; padding: 0; }
    .files li { display: grid; grid-template-columns: 1fr auto; gap: 0.25rem 0.625rem; align-items: center; border-bottom: 0.0625rem solid var(--light); padding: 0.5rem 0; font-size: 0.8438rem; }
    .files .n { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
    .files .s { color: var(--char); font-size: 0.75rem; white-space: nowrap; }
    .files .s.bad { color: var(--red); font-weight: 700; }
    .files .bar { grid-column: 1 / -1; height: 0.375rem; background: var(--light); border-radius: 0.1875rem; overflow: hidden; }
    .files .bar i { display: block; height: 100%; background: var(--ink); transition: width 0.2s; }
    .files .bar.bad i { background: var(--red); }
    .files .act { display: flex; gap: 0.625rem; font-size: 0.7813rem; }
    .files .check { display: inline-flex; width: 1.125rem; height: 1.125rem; border-radius: 50%; background: var(--green); color: var(--ink); font: 700 0.75rem var(--body); align-items: center; justify-content: center; margin-right: 0.375rem; vertical-align: -0.1875rem; }
    .box { background: #fff; border: 0.125rem solid var(--ink); padding: 0.75rem 0.875rem; margin: 0.875rem 0 0; font-size: 0.8125rem; }
    .box b.t { font-family: var(--head); font-weight: 400; font-size: 0.9375rem; text-transform: uppercase; display: block; margin-bottom: 0.25rem; }
    .row-actions { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; margin-top: 0.875rem; }
    .row-actions .fine { margin: 0; }
    .scrim { position: fixed; inset: 0; background: rgba(0,0,0,0.45); display: flex; align-items: center; justify-content: center; padding: 1.25rem; z-index: 10; }
    .modal { background: #fff; border: 0.1875rem solid var(--ink); padding: 1.125rem 1.25rem; max-width: 28.75rem; width: 100%; box-shadow: 0.5rem 0.5rem 0 var(--ink); font-size: 0.9375rem; }
    .modal h2 { font-size: 1.5rem; }
    /* Definite height: Calendly's iframe is height:100% and collapses to 9.375rem inside a min-height-only box. The script follows calendly.page_height from here. */
    .cal { height: 700px; background: #fff; border: 1.5px solid var(--grey); }
    .ts { border: 0.0625rem solid var(--grey); background: #fff; border-radius: 0.25rem; padding: 0.625rem 0.75rem; font-size: 0.8125rem; display: flex; gap: 0.625rem; align-items: center; margin: 0.875rem 0; }
    .ts .sp { width: 1.125rem; height: 1.125rem; flex: none; border: 0.1875rem solid var(--light); border-top-color: var(--ink); border-radius: 50%; animation: spin 0.9s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .ok { width: 3.375rem; height: 3.375rem; border-radius: 50%; background: var(--ink); color: #fff; display: flex; align-items: center; justify-content: center; font: 700 1.75rem var(--body); margin: 0.625rem 0 0.75rem; }
    @media (min-width: 700px) {
      .cards, .cols { grid-template-columns: 1fr 1fr; }
      h1 { font-size: 2.5rem; }
    }
    @media (prefers-reduced-motion: reduce) { .ts .sp { animation: none; } .files .bar i { transition: none; } }
    /* Desktop: every length above is rem, so the phone-first layout scales up whole. */
    @media (min-width: 1024px) { html { font-size: 18px; } }
    @media (min-width: 1440px) { html { font-size: 20px; } }
    @media (min-width: 1800px) { html { font-size: 22px; } }
  </style>
</body>
</html>
