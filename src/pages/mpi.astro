---
// /mpi/ pillar page. Source of truth (Dave, 2026-11-17): the files on main —
// src/data/mpi-body.html, src/styles/mpi.css, src/styles/mpi-site.css — edited by hand.
// They were first generated from the design board (mockups/mpi/build-astro.py on
// feat/mpi-page-design-brief); that generator is retired: never re-run it over these files.
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../data/mpi-body.html?raw';
import faqSchema from '../data/mpi-faq.json';
import '../styles/mpi.css';
import '../styles/mpi-site.css';

const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "TenthGear Voice MPI",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "iOS, Android, Web",
  "description": "A voice-first multi point inspection for dealership service departments. Techs say what they see; the MPI report, the customer video and the recommendations build themselves.",
  "publisher": { "@type": "Organization", "name": "TenthGear", "url": "https://tenthgear.ai" },
  "offers": { "@type": "Offer", "category": "Subscription" }
};
---

<BaseLayout
  title="Voice MPI: The Multi Point Inspection That Builds Itself | TenthGear"
  description="TenthGear is a voice-first multi point inspection (MPI) and digital vehicle inspection for dealerships. Techs talk; the MPI report, inspection video and customer recommendations build themselves."
  canonicalPath="/mpi/"
  schemaJson={[appSchema, faqSchema]}
>
  <div class="mpi" set:html={body} />
</BaseLayout>

<script>
  // Keep the step 2 footage on the same clock as its CSS caption animations (10.91s cycle),
  // so each shot lines up with its caption and "New finding" card even if the video loads late.
  const video = document.querySelector<HTMLVideoElement>('.mpi .vf .v2c');
  const clock = document.querySelector('.mpi .lcap2 .capline.s0 span');
  if (video && clock) {
    const CYCLE = 10.91;
    const sync = () => {
      const anim = clock.getAnimations()[0];
      const t = anim && typeof anim.currentTime === 'number' ? (anim.currentTime / 1000) % CYCLE : null;
      if (t !== null && video.readyState >= 2 && Math.abs(video.currentTime - t) > 0.12) video.currentTime = t;
    };
    video.addEventListener('playing', sync);
    setInterval(sync, 1000);
  }
</script>

