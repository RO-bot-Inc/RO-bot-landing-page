    "@tailwindcss/typography": "^0.5.19",
    "astro": "^7.3.2",
    "autoprefixer": "^10.6.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "unist-util-visit": "^5.1.0"
  }
